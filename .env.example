# Base URL of the LinkInBio Pro backend.
# Leave empty locally — vite.config.js proxies /api to http://localhost:5000.
# In production set this to the deployed backend, e.g. https://linkinbio-pro-api.onrender.com
VITE_API_URL=

# Optional: used to build the "copy your link" string shown in the dashboard.
VITE_PUBLIC_URL=http://localhost:5173
